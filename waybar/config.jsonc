{
  "layer": "bottom",
  "height": 23,
  "margin-bottom": 0,
  "modules-left": [],
  "modules-center": ["hyprland/workspaces", "custom/perf", "pulseaudio", "battery", "bluetooth", "network#wlp0", "clock"],
  "modules-right": [],

  "spacing": 0,

  "custom/perf": {
    "exec": "sh ~/ricing/waybar/perf.sh",
    "interval": 2,
    "return-type": "json",
    "tooltip": true
  },

  "bluetooth": {
	// "controller": "controller1", // specify the alias of the controller if there are more than 1 on the system
    "format": "",
    "format-disabled": "󰂲", // an empty format will hide the module
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
  "on-click": "blueman-manager",
  "on-click-right": "kitty bluetui"
  },
  "pulseaudio": {
    "tooltip": false,
    "scroll-step": 5,
    "format": "{volume}% {icon}",
    "format-muted": "0%  ",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "format-icons": {
      "default": [" ", " ", " "]
    }
  },

  "hyprland/workspaces": {
    "format": "{name}",
    "format-icons": {
      "active": " ", // Filled dot for active workspace
      "default": " ", // Hollow dot for occupied workspace
      "empty": " ", // Hollow dot for empty workspace
    },
    "disable-scroll": true,
  },
  "network#wlp0": {
    "interface": "wlp0s20f3",
    "family": "ipv4",
    "format-wifi": " ",
    "format-ethernet": "󰈀 ",
    "format-disconnected": "󰌙 ",
    "tooltip": true,
    "tooltip-format": "{ifname}\nIP: {ipaddr}/{cidr}\nUp: {bandwidthUpBytes}\nDown: {bandwidthDownBytes}",
    "tooltip-format-wifi": "{essid}\nIP: {ipaddr}/{cidr}\nSignal: {signalStrength}%\nUp: {bandwidthUpBytes}\nDown: {bandwidthDownBytes}",
    "tooltip-format-ethernet": "{ifname}\nIP: {ipaddr}/{cidr}\nUp: {bandwidthUpBytes}\nDown: {bandwidthDownBytes}",
    "interval": 1,
    "max-length": 30,
  },
  "battery": {
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 10,
    },
    "format": "{icon}",
    "format-charging": "󱐋 ",
    "format-plugged": " ",
    "format-alt": "{time} {icon} ",
    "format-icons": [" ", " ", " ", " ", " "],
    "tooltip-format" : "{capacity}% \n{time} remaining",
    "tooltip-format-charging": "{capacity}% \nCharging",
    "tooltip-format-plugged": "{capacity}% \nPlugged in",
    "tooltip-format-full": "{capacity}% \nFully charged"
  },
  "clock": {
    "format": "{:%H:%M}  ",
    "format-alt": "{:%A, %B %d, %Y   %H:%M}  ",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#fab387'><b>{}</b></span>",
        "days": "<span color='#a6e3a1'><b>{}</b></span>",
        "weeks": "<span color='#89b4fa'><b>W{}</b></span>",
        "weekdays": "<span color='#f5c2e7'><b>{}</b></span>",
        "today": "<span color='#f38ba8'><b><u>{}</u></b></span>",
      },
    },
    "actions": {
      "on-click-right": "mode",
      "on-click-forward": "tz_up",
      "on-click-backward": "tz_down",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down",
    },
  },
}
